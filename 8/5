n = int(input("Введите количество чисел: "))

if n <= 2:
    print("Нужно больше двух чисел")

else:
    first = int(input("Введите число №1: "))
    second = int(input("Введите число №2: "))
    if first < second:
        first, second = second, first
    for i in range(3, n + 1):
        num = int(input(f"Введите число №{i}: "))
        if num > first:
            second, first = first, num
        elif num > second:
            second = num
print(f"""Наибольшее число из списка: {first}
второе число: {second}""")
