class Monster:
    def __init__(self, name, hp, power):
        self.name = name
        self.hp = hp
        self.power = power

    def mutate(self):
            self.power += 5
            print(f"{self.name} мутирует! Сила увеличена!")
            print(self.power)

    def rest(self):
        self.hp += 10
        print(f"{self.name} отдыхает в склепе! Здоровье восстановленно!")
        print(self.hp)

m1 = Monster("Люкан", 90, 15)

m1.mutate()
m1.rest()
