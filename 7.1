ocenka = int(input("Введите рейтинг продукта от 1 до 10😋: "))

match ocenka:
    case 1 | 2 | 3:
        print("Отвратительный продукт 🤢 не рекомендую")
    case 4 | 5 | 6:
        print("средненький продукт 😊 можно попробовать)")
    case 7 | 8:
        print("Хороший продукт 😍 пробуй, не пожалеешь))")
    case 9 | 10:
        print("Отличный продукт!! 🤩 Настоятельно рекомендую!!!!!")
    case _:
        print("Нет такого рейтинга❌")
