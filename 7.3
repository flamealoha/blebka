print("""         ┌───┬─────────────┬───────────┐
         │ № │   Напиток   │ Цена      │
         ├───┼─────────────┼───────────┤
         │ 1 │   Кофе☕    │120 рублей │
         ├───┼─────────────┼───────────┤
         │ 2 │    Чай🍵    │80 рублей  │
         ├───┼─────────────┼───────────┤
         │ 3 │    Сок🧃    │100 рублей │
         ├───┼─────────────┼───────────┤
         │ 4 │    Вода💧   │50 рублей  │
         ├───┼─────────────┼───────────┤
         │ 5 │  Лимонад🥤  │90 рублей  │
         └───┴─────────────┴───────────┘""")
drink = input("Введите номер или название напитка: ")
kolvo = int(input("Введите количество: "))

match drink:
    case "1" | "Кофе":
        name = "Кофе"
        price = 120
    case "2" | "Чай":
        name = "Чай"
        price = 80
    case "3" | "Сок":
        name = "Сок"
        price = 100
    case "4" | "Вода":
        name = "Вода"
        price = 50
    case "5" | "Лимонад":
        name = "Лимонад"
        price = 90

summa = price * kolvo

skidka = 0
discount_code = input("Код скидки: ")
if discount_code == "STUDENT":
    skidka = summa * 0.2

itogo = summa - skidka

print("========================================")
print("         КВИТАНЦИЯ КАФЕ")
print("========================================")
print("Товар:", name)
print("Цена за порцию:", price, "руб")
print("Количество:", kolvo, "порций")
print("Сумма:", summa, "руб")
if skidka > 0:
    print("Скидка \"STUDENT\":", "-" + str(int(skidka)), "руб")
print("----------------------------------------")
print("К ОПЛАТЕ:", int(itogo), "руб")
print("========================================")
