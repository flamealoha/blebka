# ПАРА 2 — ОБЛАКО
# =====================================================
COLOR_CLOUD = "White"
def oblaka(x,y):
    coords = [
        (100, 280, 40),
        (70, 290, 30),
        (130, 290, 30),
        (50, 270, 25),
        (150, 270, 25),
        (100, 260, 35),
    ]
    t.penup()
    t.goto(x,y)
    t.color(COLOR_CLOUD)
    for circle_x, circle_y, radius in coords:
        t.penup()
        t.goto(x + circle_x, y + circle_y - radius)
        t.pendown()
        t.begin_fill()
        t.circle(radius)
        t.end_fill()
oblaka(-300,50)
oblaka(-100,50)
oblaka(200,70)

HEART_COLOR = "red"
PEREVERTISH = 140
#ДЕКОР
def decor(x, y):
    t.penup()
    t.goto(x, y)
    t.setheading(PEREVERTISH)
    t.pendown()
    t.color(HEART_COLOR)
    t.begin_fill()
    t.circle(-35, 200)
    t.left(120)
    t.circle(-35, 200)
    t.forward(62)
    t.end_fill()
decor(-300, 50)
decor(200, 50)

# НАДПИСЬ
TEXT_1 = "С 8 Марта!"
TEXT_2 = "Дорогие женщины!"
TEXT_3 = "Пусть каждый день будет ярким!"
TEXT_POS = "center"
MAIN_FONT_SIZE_1 = ("Arial", 36, "bold")
MAIN_FONT_SIZE_2 = ("Arial", 20, "italic")
MAIN_FONT_SIZE_3 = ("Arial", 20, "normal")
COLOR_TEXT_1 = "purple"
COLOR_TEXT_2 = "deeppink"
COLOR_TEXT_3 = "blue"
def nadpis(x1, y1, x2, y2, x3, y3):
    t.penup()
    t.goto(x1, y1)
    t.pendown()
    t.color(COLOR_TEXT_1)
    t.write(TEXT_1, align = TEXT_POS, font = MAIN_FONT_SIZE_1)
    t.penup()
    t.goto(x2, y2)
    t.pendown()
    t.color(COLOR_TEXT_2)
    t.write(TEXT_2, align = TEXT_POS, font=MAIN_FONT_SIZE_2)
    t.penup()
    t.goto(x3, y3)
    t.color(COLOR_TEXT_3)
    t.write(TEXT_3, align = TEXT_POS, font=MAIN_FONT_SIZE_3)
nadpis(0, 31, 0,15,0,-5)


