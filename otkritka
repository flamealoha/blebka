import turtle
t = turtle.Turtle()
t.speed(0)
t.hideturtle()
screen = turtle.Screen()
screen.bgcolor("lightblue")
screen.setup(width=800, height=700)
# =====================================================
# ПАРА 1 — СОЛНЫШКО
# =====================================================
COLOR_SUB = 'yellow'
WIDTH_LUCHI = 6
COUNT_LUCHI = 16
UGOL_LUCHI = 22.5
COLOR_LUCHI = 'orange'
WIDTH_CONTUR = 1
SIZE_CIRCLE = 50
DLINA_LUCHI = 90

def sun(x1, y1, x2, y2):
    t.color(COLOR_LUCHI)
    t.width(WIDTH_LUCHI)
    for i in range(COUNT_LUCHI):
        t.penup()
        t.goto(x1, y1)
        t.pendown()
        t.setheading(i * UGOL_LUCHI)
        t.forward(DLINA_LUCHI)
    t.width(WIDTH_CONTUR)
    t.penup()
    t.goto(x2, y2)
    t.pendown()
    t.color(COLOR_SUB)
    t.begin_fill()
    t.circle(SIZE_CIRCLE)
    t.end_fill()


sun(300, 300, 280, 247)

