STEBEL_COLOR = "darkgreen"
CVETOK_COLOR = "pink"
CENTER_COLOR = "yellow"
def cvetok(x, y):
    t.color(STEBEL_COLOR)
    t.width(4)
    t.penup()
    t.goto(x, y)
    t.pendown()
    t.setheading(90)
    t.forward(120)
    t.width(1)
    t.color(CVETOK_COLOR)
    for i in range(8):
        t.penup()
        t.goto(0, -180)
        t.pendown()
        t.setheading(i * 45)
        t.begin_fill()
        t.circle(30, 180)
        t.circle(30, 180)
        t.end_fill()
    t.penup()
    t.goto(0, -180)
    t.pendown()
    t.color(CENTER_COLOR)
    t.begin_fill()
    t.circle(20)
    t.end_fill()
cvetok(0, -300)
COLOR_TRAVA = "green"
START_X = -400
START_Y = -350
BLADE_COUNT =  10
TRAVA_RANGE = 80
TRAVA_FORWARD = 10
BLADE_CIRCLE = 70

t.color(COLOR_TRAVA)
for i in range(TRAVA_RANGE):
    t.penup()
    t.goto(START_X + i * BLADE_COUNT, START_Y)
    t.pendown()
    d = 1 if i % 2 == 0 else -1
    t.setheading(75 + (i % 5) * 10)
    t.width(3 - (i % 2))
    n = BLADE_CIRCLE + (i % 30)
    for j in range(int(n / 10)):
        t.forward(TRAVA_FORWARD)
        t.left(5 * d)
    t.width(1)

turtle.done()
