status = input("Введите статус вашего заказа: ")

print("""
      ┌──────────────────────────────┐
      │  📦 СТАТУС ВАШЕГО ЗАКАЗА 📦  │
      └──────────────────────────────┘""")

match status:
    case "pending" | "в ожидании":
        print("""Статус: В ожидании ⌛
        Примерное время: +-30 дней
        рекомендация: Следите за уведомлениями""")

    case "processing" | "в обработке":
        print("""Статус: В обработке
        Примерное время: 25 дней
        рекомендация: Продолжайте следить за уведомлениями""")

    case "shipped" | "отправлено":
        print("""Статус: Отправлено 🛫
        Примерное время: 10 дней
        рекомендация: Следите за уведомлениями о доставке""")

    case "delivered" | "доставлено":
        print("""Статус: Доставлено 🛬
        Примерное время: 0 дней
        рекомендация: Можете забирать свой заказ)""")

    case "cancelled" | "отменено":
        print("""Статус: Отменено ❌
        Примерное время: 0 дней
        рекомендация: Заказ отменён😭""")

    case _:
        print("Ошибка: Неизвестный статус 'invalid_status'")
