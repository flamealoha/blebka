import turtle
import math

# Настройка экрана
screen = turtle.Screen()
screen.setup(900, 700)
screen.bgcolor("#87CEEB")
screen.title("Летящая пчёлка 🐝")
screen.tracer(0)

# Создаем черепаху для пчёлки
bee = turtle.Turtle()
bee.speed(0)
bee.penup()
bee.hideturtle()

# Переменные для анимации крыльев
wing_angle = 0
wing_direction = 5

def draw_bee(x, y, body_angle, wing_angle):
    """Рисует красивую пчёлку с машущими крыльями"""
    bee.clear()
    bee.goto(x, y)
    bee.setheading(body_angle)
    
    # === ТЕЛО (овал) ===
    bee.pendown()
    bee.color("#FFD700", "#FFD700")  # Золотисто-жёлтый
    bee.begin_fill()
    bee.setheading(body_angle)
    # Рисуем вытянутый овал
    for _ in range(2):
        bee.circle(25, 90)
        bee.circle(10, 90)
    bee.end_fill()
    bee.penup()
    
    # === ЧЁРНЫЕ ПОЛОСКИ ===
    bee.pensize(6)
    bee.color("black")
    for offset in [-8, 0, 8, 16]:
        bee.goto(x + offset * math.cos(math.radians(body_angle - 90)), 
                 y + offset * math.sin(math.radians(body_angle - 90)))
        bee.setheading(body_angle + 90)
        bee.pendown()
        bee.forward(30)
        bee.penup()
    
    # === ГОЛОВА ===
    bee.goto(x + 35, y + 5)
    bee.setheading(body_angle)
    bee.pendown()
    bee.color("#FFD700", "#FFD700")
    bee.begin_fill()
    bee.circle(18)
    bee.end_fill()
    bee.penup()
    
    # === ГЛАЗА ===
    # Белок глаза
    bee.goto(x + 42, y + 15)
    bee.pendown()
    bee.color("white")
    bee.begin_fill()
    bee.circle(6)
    bee.end_fill()
    
    # Зрачок
    bee.goto(x + 44, y + 17)
    bee.pendown()
    bee.color("black")
    bee.begin_fill()
    bee.circle(3)
    bee.end_fill()
    
    # Блик в глазу
    bee.goto(x + 46, y + 19)
    bee.pendown()
    bee.color("white")
    bee.begin_fill()
    bee.circle(1.2)
    bee.end_fill()
    bee.penup()
    
    # === УСИКИ ===
    bee.pensize(2)
    bee.color("brown")
    # Левый усик
    bee.goto(x + 40, y + 25)
    bee.setheading(body_angle + 30)
    bee.pendown()
    bee.forward(25)
    bee.circle(3)
    # Правый усик
    bee.penup()
    bee.goto(x + 40, y + 25)
    bee.setheading(body_angle - 30)
    bee.pendown()
    bee.forward(25)
    bee.circle(3)
    bee.penup()
    
    # === КРЫЛЬЯ (с анимацией) ===
    bee.color("#87CEEB", "lightblue")
    bee.pensize(1)
    
    # Верхнее крыло
    bee.goto(x + 15, y + 15)
    bee.setheading(body_angle + 20 + wing_angle)
    bee.pendown()
    bee.begin_fill()
    bee.circle(30, 120)
    bee.left(120)
    bee.circle(30, 120)
    bee.end_fill()
    bee.penup()
    
    # Нижнее крыло
    bee.goto(x + 15, y + 5)
    bee.setheading(body_angle - 20 - wing_angle)
    bee.pendown()
    bee.begin_fill()
    bee.circle(25, 120)
    bee.left(120)
    bee.circle(25, 120)
    bee.end_fill()
    bee.penup()
    
    # === ЖАЛО ===
    bee.goto(x - 30, y)
    bee.setheading(body_angle - 180)
    bee.pendown()
    bee.color("black")
    bee.pensize(3)
    bee.forward(12)
    bee.penup()
    
    # === НОЖКИ ===
    bee.pensize(2)
    bee.color("darkorange")
    for leg_offset in [-15, -5, 5]:
        bee.goto(x + leg_offset, y - 15)
        bee.setheading(body_angle - 60)
        bee.pendown()
        bee.forward(15)
        bee.right(90)
        bee.forward(5)
        bee.penup()

# Рисуем красивые цветы
def draw_flower(x, y, color):
    flower = turtle.Turtle()
    flower.speed(0)
    flower.penup()
    flower.goto(x, y)
    flower.pendown()
    
    # Стебель
    flower.color("green")
    flower.pensize(4)
    flower.setheading(270)
    flower.forward(60)
    
    # Лепестки
    flower.pensize(1)
    flower.color(color)
    flower.begin_fill()
    for _ in range(6):
        flower.circle(18)
        flower.left(60)
    flower.end_fill()
    
    # Серединка
    flower.color("#FFD700")
    flower.begin_fill()
    flower.circle(10)
    flower.end_fill()
    flower.hideturtle()

# Облачко
def draw_cloud(x, y):
    cloud = turtle.Turtle()
    cloud.speed(0)
    cloud.penup()
    cloud.goto(x, y)
    cloud.color("white")
    cloud.begin_fill()
    for _ in range(4):
        cloud.circle(30)
        cloud.forward(40)
    cloud.end_fill()
    cloud.hideturtle()

# Рисуем фон
draw_cloud(-300, 200)
draw_cloud(100, 250)
draw_cloud(350, 180)

draw_flower(-350, -200, "#FF69B4")  # Розовый цветок
draw_flower(-200, -250, "#FF6347")  # Красный цветок
draw_flower(150, -220, "#DA70D6")   # Орхидея
draw_flower(350, -180, "#FFB6C1")   # Светло-розовый

