# Параметры полёта
x, y = -450, -50
time_var = 0
speed = 3.5
wing_angle_var = 0
wing_delta = 4

# Текст приветствия
welcome = turtle.Turtle()
welcome.hideturtle()
welcome.penup()
welcome.goto(0, 300)
welcome.color("darkblue")
welcome.write("🐝 Пчёлка летит собирать нектар! 🐝", 
              align="center", font=("Arial", 20, "bold"))

# Основной цикл анимации
while x < 550:
    # Траектория полёта (синусоида)
    y = 50 + math.sin(time_var * 1.8) * 80
    # Наклон пчёлки
    body_angle = math.sin(time_var * 2.5) * 15
    
    # Анимация маха крыльями
    wing_angle_var += wing_delta
    if wing_angle_var > 30 or wing_angle_var < -30:
        wing_delta = -wing_delta
    
    # Рисуем пчёлку
    draw_bee(x, y, body_angle, wing_angle_var)
    
    # Обновляем экран
    screen.update()
    
    # Движение вперёд
    x += speed
    time_var += 0.07
    
    turtle.time.sleep(0.02)

# Финальное сообщение
welcome.clear()
welcome.goto(0, 0)
welcome.write("🐝 Пчёлка прилетела на полянку! 🐝", 
              align="center", font=("Arial", 22, "bold"))

screen.exitonclick()
