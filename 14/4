import random
spisok = []
for i in range(10):
    big_spisok = [random.randint(-10,10) for j in range(5)]
    spisok.append(big_spisok)
    print(big_spisok)
find = int(input("Введите число из списка: "))
poisk = []
for i in range(len(spisok)):
    for j in range(len(spisok[i])):
        if spisok[i][j] == find:
            poisk.append((i,j))
print(poisk)
